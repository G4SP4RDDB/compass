# Free key from https://dashboard.alchemy.com/ — gas price (eth_gasPrice),
# cotes de swap (Uniswap V3 QuoterV2 via eth_call) sur toutes les chains EVM,
# et conversion USD (Prices API, aussi utilisée pour Solana) via un seul et
# même endpoint/clé.
# IMPORTANT : seul Ethereum est activé par défaut sur une nouvelle app, il
# faut activer manuellement Arbitrum/Optimism/Polygon/Base/BNB/Avalanche dans
# le dashboard de l'app (onglet "Networks").
ALCHEMY_API_KEY=

# Optional: defaults to the public https://api.mainnet-beta.solana.com if unset.
# Set this to a paid provider (Helius, QuickNode, ...) for higher rate limits.
SOLANA_RPC_URL=

# Basic auth for https://simulator.zfund.io/margin/live.ensemble (target/balance feed).
ZFUND_USERNAME=
ZFUND_PASSWORD=

# --- compass_test (see compass_test/README.md, config.py) -----------------
# Everything below is only read by the compass_test harness, not main.py's
# graph solver/visualization. compass_test also loads piggybank-arb/.env
# directly (DEX credentials: MEXC_API_KEY/SECRET, ADEN_API_KEY/SECRET,
# ADEN_WALLET_ADDRESS, ADEN_DEVICE_FINGERPRINT, etc.) — those stay in that
# project's own .env/.env.example, not duplicated here.

# Operating wallet that signs a Deposit hop's on-chain tx and receives a
# Withdraw hop's funds. Treat as test-only funds.
COMPASS_TEST_WALLET_PRIVATE_KEY=
COMPASS_TEST_WALLET_KEY_VAR=COMPASS_TEST_WALLET_PRIVATE_KEY

# One of TWO independent gates a live run needs — the other is --live + a
# typed confirmation on the CLI, or `confirm: "YES"` in the frontend's
# /api/test-hop request body. Must be the exact string "1" ("true" stays off).
COMPASS_TEST_ALLOW_LIVE=

# Hard per-hop/per-run $ caps (executor._check_caps). Defaults to 10/20 if unset.
COMPASS_TEST_MAX_USD_PER_HOP=
COMPASS_TEST_MAX_USD_PER_RUN=

# Hardcoded deposit addresses, one per (DEX, chain) pair actually tested —
# COMPASS_TEST_EXPECTED_DEPOSIT_ADDRESS_<DEX>_<CHAIN>, copied from that
# exchange's own Deposit screen (config.py's expected_deposit_address). A
# pair left unset here simply can't build a deposit tx yet.
COMPASS_TEST_EXPECTED_DEPOSIT_ADDRESS_MEXC_BSC=
COMPASS_TEST_EXPECTED_DEPOSIT_ADDRESS_ADEN_BSC=
COMPASS_TEST_EXPECTED_DEPOSIT_ADDRESS_ADEN_ARBITRUM=

# Dedicated Aster agent for compass_test's own withdraw testing, separate
# from piggybank-arb's own trading agent — falls through to that project's
# ASTER_SIGNER/ASTER_PRIVATE_KEY (via piggybank-arb/.env) if left unset here.
ASTER_SIGNER=
ASTER_PRIVATE_KEY=
