# Free key from https://etherscan.io/apis — works across all Etherscan V2
# supported chains (Ethereum, Arbitrum, BSC, Polygon, Base, Optimism).
ETHERSCAN_API_KEY=

# Optional: defaults to the public https://api.mainnet-beta.solana.com if unset.
# Set this to a paid provider (Helius, QuickNode, ...) for higher rate limits.
SOLANA_RPC_URL=
